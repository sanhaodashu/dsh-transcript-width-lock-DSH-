{
  "name": "dsh-transcript-width-lock",
  "version": "1.0.0",
  "description": "DeepSeek Harness desktop plugin: make the transcript-width drag handles visible and lock them so selecting text never changes the reading width.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "conversation",
    "transcript-width",
    "resize-lock"
  ],
  "license": "MIT",
  "author": "sanhaodashu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanhaodashu/dsh-transcript-width-lock.git"
  },
  "homepage": "https://github.com/sanhaodashu/dsh-transcript-width-lock#readme",
  "bugs": {
    "url": "https://github.com/sanhaodashu/dsh-transcript-width-lock/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/banner.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "manifestVersion": 1
  }
}